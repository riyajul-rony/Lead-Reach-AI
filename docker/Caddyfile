{
    admin off
    email {$ADMIN_EMAIL:admin@example.com}
    on_demand_tls {
        ask http://web:3000/api/internal/tls-ask?secret={$CTD_TLS_ASK_SECRET:}
    }
}

{$APP_DOMAIN:localhost} {
    encode zstd gzip

    # Modern production security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # Static assets long-term caching
    @static {
        path /_next/static/*
        path /static/*
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # Forward traffic to Next.js Web service
    reverse_proxy web:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# Verified Custom Tracking Domains (CNAME on-demand TLS)
https:// {
    tls {
        on_demand
    }
    encode zstd gzip

    @allowed_tracking {
        path /api/v1/track/*
        path /api/v1/unsubscribe/*
        path /u/*
    }
    handle @allowed_tracking {
        reverse_proxy web:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
    handle {
        respond "Not Found" 404
    }
}
