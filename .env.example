# ==============================================================================
# Lead Reach AI — Environment Configuration Template
# Copy this file to .env and provide your production or local development values:
#   cp .env.example .env
# Never commit real secrets to git.
# ==============================================================================

# --- Traefik Reverse Proxy Configuration (docker-compose.yml) ---
# Match your host Traefik external network, HTTPS entrypoint, and cert resolver:
TRAEFIK_NETWORK=n8n-scad_cerkitlabs
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# --- Application Core ---
NODE_ENV=production
PORT=3000
TZ=UTC
APP_DOMAIN=app.yourdomain.com
APP_URL=https://app.yourdomain.com
# Legacy fallback URL alias read by some URL helpers if APP_URL is unset:
NEXTAUTH_URL=https://app.yourdomain.com
# Optional comma-separated hostnames allowed during `next dev` (dev only):
# ALLOWED_DEV_ORIGINS=localhost:3000

# --- Security & Cryptography (MANDATORY IN PRODUCTION) ---
# Required: 32+ character random secret for session / OAuth state HMAC signing
# Generate via: openssl rand -base64 32
AUTH_SECRET=replace_with_32_plus_char_random_auth_secret

# Required: 32-byte key (Base64 or 64-char hex) for AES-256-GCM encryption of stored keys/credentials
# Generate via: openssl rand -base64 32
APP_ENCRYPTION_KEY=replace_with_32_byte_base64_encryption_key

# Recommended: Dedicated 32+ char HMAC secret for click-tracking links (falls back to AUTH_SECRET/APP_ENCRYPTION_KEY)
# Setting a separate TRACKING_SECRET ensures rotating AUTH_SECRET does not invalidate active email tracking links.
# Generate via: openssl rand -base64 32
TRACKING_SECRET=replace_with_32_plus_char_tracking_secret

# Required for Custom Tracking Domains (Caddy on_demand_tls ask gate /api/internal/tls-ask)
# Generate via: openssl rand -hex 24
CTD_TLS_ASK_SECRET=replace_with_random_tls_ask_secret

# Optional: Dedicated secret for `x-internal-health-secret` header on GET /api/health
# When unset, GET /api/health falls back to CTD_TLS_ASK_SECRET for internal detailed checks (otherwise returns { ok: true }).
HEALTH_CHECK_SECRET=replace_with_random_health_check_secret

# Content-Security-Policy mode: keep "false" in production to enforce CSP; set "true" only to test violations
CSP_REPORT_ONLY=false

# --- PostgreSQL Database (MANDATORY IN PRODUCTION) ---
POSTGRES_USER=leadreach
POSTGRES_PASSWORD=replace_with_strong_postgres_password
POSTGRES_DB=leadreach

# Connection string:
# Local PC development (connecting to Docker DB on port 5432):
# DATABASE_URL="postgresql://leadreach:replace_with_strong_postgres_password@localhost:5432/leadreach"
# Docker container network (internal compose network):
DATABASE_URL="postgresql://leadreach:replace_with_strong_postgres_password@db:5432/leadreach"

# --- Redis (Queues & Cache) ---
# Local PC development: redis://localhost:6379
# Docker container network: redis://redis:6379
REDIS_URL="redis://redis:6379"

# --- Admin, Registration, Free Trial & Legal Policy ---
ADMIN_EMAIL=admin@yourdomain.com
# Registration modes: "open", "invite", "closed" (note: src/server/env.ts uses "open", "invite", "closed")
REGISTRATION_MODE=invite
# Default free-trial length in days on signup (overridable in Admin Setup; set 0 to disable free trial)
TRIAL_DAYS=14
# Optional legal terms version identifier; bump to require re-acknowledgement before next campaign launch
LEGAL_TERMS_VERSION=2026-11-v1

# --- System SMTP (Transactional Emails, Trial Reminders & Password Resets) ---
SYSTEM_SMTP_HOST=smtp.example.com
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_USER=no-reply@yourdomain.com
SYSTEM_SMTP_PASS=replace_with_smtp_password
SYSTEM_SMTP_FROM="Lead Reach AI <no-reply@yourdomain.com>"

# --- AI & Lead Enrichment Providers (Optional / Admin Configurable) ---
OPENAI_API_KEY=
DEFAULT_TEXT_MODEL=gpt-4o-mini
DEFAULT_IMAGE_MODEL=dall-e-3
# Reply AI categorization overrides (defaults to openai / gpt-4o-mini; falls back to OPENAI_API_KEY)
REPLY_AI_PROVIDER=openai
REPLY_AI_MODEL=gpt-4o-mini
REPLY_AI_API_KEY=
APIFY_TOKEN=

# --- OAuth & Social Media Providers (Optional / Admin Configurable) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Background Worker, Schedulers, Warm-up & Sending Controls ---
# MUST be "true" on the worker service so outreach dispatch, warm-up pool, reply polling & maintenance cron jobs run.
# In Docker Compose, `worker` defaults this to true while `web` defaults it to false.
SCHEDULERS_ENABLED=true
# Hours after which overdue scheduled posts/jobs are marked needs_review instead of burst-sending
STALE_THRESHOLD_HOURS=24
# Minutes before an in-progress email send or lead search is treated as stuck and recovered
STUCK_SENDING_MINUTES=15
STUCK_LEAD_SEARCH_MINUTES=30

# Self warm-up pool cadence (minutes between ticks, 1-1440) and max warm-up pairs per tick (1-50)
SELF_WARMUP_INTERVAL_MINUTES=15
SELF_WARMUP_MAX_PER_TICK=5

# Global randomized per-account send jitter bounds in seconds (min >= 30)
SEND_JITTER_MIN_SECONDS=120
SEND_JITTER_MAX_SECONDS=300

# --- Custom Tracking Domains (Optional) ---
# Canonical CNAME target hostname customers point their tracking subdomains to (defaults to APP_DOMAIN host)
TRACKING_CNAME_TARGET=track.yourdomain.com

# --- Storage & Operations ---
STORAGE_PATH=/data/uploads
BACKUP_RETENTION_DAYS=7
LOG_LEVEL=info
